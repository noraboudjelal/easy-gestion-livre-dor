# Copie ces deux valeurs depuis Supabase (Project Settings > API)
# et ajoute-les dans Vercel (Settings > Environment Variables).
# Ne mets jamais de vraies valeurs dans ce fichier, il est juste un exemple.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_PASSWORD=

# Secrets exclusivement serveur (ne jamais préfixer par NEXT_PUBLIC_)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

